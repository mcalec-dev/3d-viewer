{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d.mcalec.dev/json/texture.schema.json",
  "title": "3D Viewer Texture Manifest",
  "type": "object",
  "required": ["textures"],
  "properties": {
    "$schema": { "type": "string" },
    "textures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    }
  },
  "additionalProperties": false
}
